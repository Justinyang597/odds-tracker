# Copy this file to .env and fill in your values.
# Never commit .env to source control.

DATABASE_URL=postgres://oddsuser:oddspass@postgres:5432/oddsdb
REDIS_URL=redis://redis:6379

ODDS_API_KEY=your_key_here
ODDS_API_BASE=https://api.the-odds-api.com/v4

POLL_INTERVAL_SECONDS=60
# Faster interval (seconds) used automatically when a game has started.
LIVE_POLL_INTERVAL_SECONDS=15
MOVEMENT_THRESHOLD_SPREAD=0.5
MOVEMENT_THRESHOLD_MONEYLINE=10

PORT=8080

# For local development (outside Docker), point at localhost instead:
# DATABASE_URL=postgres://oddsuser:oddspass@localhost:5432/oddsdb
# REDIS_URL=redis://localhost:6379
